<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Best Teacher Award | Anjinamma P</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    min-height:100vh;
    font-family:'Poppins',sans-serif;
    background:
        radial-gradient(circle at 50% 20%, #513b08 0%, #181205 30%, #050505 75%);
    color:white;
    overflow-x:hidden;
}

/* GOLD PARTICLES */

.particles{
    position:fixed;
    inset:0;
    pointer-events:none;
    z-index:0;
}

.particles span{
    position:absolute;
    width:4px;
    height:4px;
    background:#ffd76a;
    border-radius:50%;
    box-shadow:0 0 12px #ffd76a;
    animation:float 6s infinite ease-in-out;
}

.particles span:nth-child(1){left:8%;top:20%;animation-delay:0s}
.particles span:nth-child(2){left:20%;top:70%;animation-delay:1s}
.particles span:nth-child(3){left:32%;top:15%;animation-delay:2s}
.particles span:nth-child(4){left:45%;top:80%;animation-delay:3s}
.particles span:nth-child(5){left:60%;top:25%;animation-delay:1s}
.particles span:nth-child(6){left:72%;top:65%;animation-delay:2s}
.particles span:nth-child(7){left:85%;top:18%;animation-delay:4s}
.particles span:nth-child(8){left:94%;top:75%;animation-delay:2s}

@keyframes float{
    0%,100%{
        transform:translateY(0) scale(1);
        opacity:.4;
    }
    50%{
        transform:translateY(-40px) scale(1.7);
        opacity:1;
    }
}

/* MAIN */

.container{
    position:relative;
    z-index:2;
    min-height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    padding:50px 20px;
}

/* AWARD CARD */

.award-card{
    width:min(1050px,95%);
    min-height:680px;
    position:relative;

    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,.10),
            rgba(255,255,255,.025)
        );

    border:1px solid rgba(255,215,100,.55);
    border-radius:35px;

    backdrop-filter:blur(18px);

    box-shadow:
        0 0 30px rgba(255,193,7,.12),
        0 30px 100px rgba(0,0,0,.8);

    text-align:center;
    padding:55px 30px;
    overflow:hidden;

    animation:appear 1.2s ease;
}

@keyframes appear{
    from{
        opacity:0;
        transform:translateY(40px) scale(.96);
    }
    to{
        opacity:1;
        transform:translateY(0) scale(1);
    }
}

/* GOLD BORDER */

.award-card::before{
    content:"";
    position:absolute;
    inset:12px;
    border:1px solid rgba(255,215,100,.25);
    border-radius:25px;
    pointer-events:none;
}

/* TOP */

.small-title{
    color:#f7d477;
    font-size:15px;
    letter-spacing:6px;
    text-transform:uppercase;
    font-weight:600;
}

.school{
    margin-top:12px;
    font-family:'Cinzel',serif;
    font-size:24px;
    font-weight:700;
    color:#fff5d0;
}

/* TROPHY */

.trophy{
    margin:35px auto 20px;
    width:120px;
    height:120px;

    display:flex;
    justify-content:center;
    align-items:center;

    font-size:70px;

    border-radius:50%;

    background:
        radial-gradient(circle,#ffe89b,#c99118 65%,#6b4700);

    box-shadow:
        0 0 25px #e9b83f,
        0 0 70px rgba(255,196,55,.35);

    animation:trophyGlow 2.5s infinite alternate;
}

@keyframes trophyGlow{
    from{
        transform:scale(1);
        box-shadow:0 0 20px #e9b83f;
    }
    to{
        transform:scale(1.06);
        box-shadow:
            0 0 35px #ffd86b,
            0 0 90px rgba(255,193,7,.4);
    }
}

/* HEADING */

.award-title{
    font-family:'Cinzel',serif;
    font-size:clamp(42px,7vw,78px);
    line-height:1.05;

    background:
        linear-gradient(
            90deg,
            #fff1a8,
            #dca92e,
            #fff5b9,
            #c68d16
        );

    -webkit-background-clip:text;
    color:transparent;

    text-shadow:
        0 0 30px rgba(255,203,74,.15);

    margin-top:20px;
}

.subtitle{
    margin-top:14px;
    font-size:18px;
    letter-spacing:4px;
    color:#ddd;
    text-transform:uppercase;
}

/* TEACHER */

.teacher{
    margin-top:35px;
}

.teacher-label{
    font-size:14px;
    letter-spacing:5px;
    color:#cda641;
    text-transform:uppercase;
}

.teacher-name{
    margin-top:8px;

    font-family:'Cinzel',serif;
    font-size:clamp(34px,6vw,58px);

    color:#ffffff;

    font-weight:700;

    text-shadow:
        0 0 25px rgba(255,215,100,.25);
}

/* MESSAGE */

.message{
    max-width:700px;
    margin:20px auto;

    font-size:16px;
    line-height:1.8;
    color:#d7d7d7;
}

/* DIVIDER */

.divider{
    width:180px;
    height:2px;
    margin:25px auto;

    background:
        linear-gradient(
            90deg,
            transparent,
            #e6b63c,
            transparent
        );

    box-shadow:0 0 15px #e6b63c;
}

/* FOOTER */

.footer{
    margin-top:30px;
}

.presented{
    font-size:13px;
    letter-spacing:3px;
    color:#aaa;
    text-transform:uppercase;
}

.school-name{
    margin-top:8px;
    font-family:'Cinzel',serif;
    font-size:22px;
    color:#f1d77d;
    font-weight:600;
}

.location{
    margin-top:6px;
    color:#999;
    font-size:14px;
}

/* CORNER DECORATIONS */

.corner{
    position:absolute;
    width:80px;
    height:80px;
    border-color:#d8aa3a;
    border-style:solid;
}

.corner.top-left{
    top:25px;
    left:25px;
    border-width:2px 0 0 2px;
}

.corner.top-right{
    top:25px;
    right:25px;
    border-width:2px 2px 0 0;
}

.corner.bottom-left{
    bottom:25px;
    left:25px;
    border-width:0 0 2px 2px;
}

.corner.bottom-right{
    bottom:25px;
    right:25px;
    border-width:0 2px 2px 0;
}

/* BUTTON */

.btn{
    margin-top:28px;
    display:inline-block;

    padding:13px 30px;

    border-radius:50px;

    text-decoration:none;

    color:#211600;

    font-weight:700;

    background:
        linear-gradient(
            90deg,
            #dca92e,
            #ffe28a,
            #dca92e
        );

    box-shadow:
        0 0 20px rgba(255,207,82,.25);

    transition:.3s;
}

.btn:hover{
    transform:translateY(-4px);
    box-shadow:
        0 0 35px rgba(255,207,82,.55);
}

/* MOBILE */

@media(max-width:600px){

    .award-card{
        padding:45px 18px;
        min-height:auto;
    }

    .small-title{
        font-size:11px;
        letter-spacing:3px;
    }

    .school{
        font-size:17px;
    }

    .trophy{
        width:95px;
        height:95px;
        font-size:55px;
    }

    .subtitle{
        font-size:12px;
        letter-spacing:2px;
    }

    .message{
        font-size:14px;
    }

    .corner{
        width:45px;
        height:45px;
    }
}

</style>
</head>

<body>

<!-- GOLD PARTICLES -->

<div class="particles">
    <span></span>
    <span></span>
    <span></span>
    <span></span>
    <span></span>
    <span></span>
    <span></span>
    <span></span>
</div>


<div class="container">

    <div class="award-card">

        <!-- CORNERS -->

        <div class="corner top-left"></div>
        <div class="corner top-right"></div>
        <div class="corner bottom-left"></div>
        <div class="corner bottom-right"></div>


        <!-- SCHOOL -->

        <div class="small-title">
            Gandhi Vidya Shala
        </div>

        <div class="school">
            Bengaluru
        </div>


        <!-- TROPHY -->

        <div class="trophy">
            🏆
        </div>


        <!-- AWARD -->

        <h1 class="award-title">
            Best Teacher Award
        </h1>

        <div class="subtitle">
            Excellence • Dedication • Inspiration
        </div>


        <!-- TEACHER -->

        <div class="teacher">

            <div class="teacher-label">
                Proudly Presented To
            </div>

            <div class="teacher-name">
                Anjinamma P
            </div>

        </div>


        <div class="divider"></div>


        <!-- MESSAGE -->

        <p class="message">
            In recognition of outstanding dedication, inspiring teaching,
            unwavering commitment and the positive impact made on the lives
            of students through knowledge, guidance and compassion.
        </p>


        <!-- FOOTER -->

        <div class="footer">

            <div class="presented">
                With Gratitude & Appreciation
            </div>

            <div class="school-name">
                Gandhi Vidya Shala
            </div>

            <div class="location">
                Bengaluru, Karnataka
            </div>

        </div>


        <a href="#" class="btn">
            ✦ A Teacher Who Inspires ✦
        </a>

    </div>

</div>

</body>
</html>
