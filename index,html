<title>Vishrutha Hospital | Advanced Healthcare</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, sans-serif;
}

body{
    background:#f5fbff;
    color:#123;
}

/* NAVBAR */

header{
    background:white;
    padding:18px 7%;
    display:flex;
    justify-content:space-between;
    align-items:center;
    position:sticky;
    top:0;
    z-index:1000;
    box-shadow:0 2px 15px rgba(0,0,0,0.08);
}

.logo{
    font-size:27px;
    font-weight:bold;
    color:#087f8c;
}

.logo span{
    color:#0756a3;
}

nav a{
    text-decoration:none;
    margin-left:25px;
    color:#123;
    font-weight:600;
}

nav a:hover{
    color:#087f8c;
}

/* HERO */

.hero{
    min-height:650px;
    display:flex;
    align-items:center;
    padding:80px 7%;
    background:
    linear-gradient(120deg,
    rgba(3,72,112,.95),
    rgba(0,145,155,.85));
    color:white;
}

.hero-content{
    max-width:650px;
}

.hero h1{
    font-size:58px;
    line-height:1.1;
    margin-bottom:20px;
}

.hero h1 span{
    color:#8ff3df;
}

.hero p{
    font-size:20px;
    line-height:1.7;
    margin-bottom:30px;
}

.btn{
    display:inline-block;
    padding:15px 28px;
    border-radius:30px;
    text-decoration:none;
    font-weight:bold;
    margin-right:10px;
}

.primary{
    background:white;
    color:#075b83;
}

.secondary{
    border:2px solid white;
    color:white;
}

/* STATS */

.stats{
    display:flex;
    justify-content:center;
    gap:50px;
    padding:35px;
    background:white;
    box-shadow:0 5px 20px rgba(0,0,0,.08);
}

.stat{
    text-align:center;
}

.stat h2{
    color:#07868c;
    font-size:32px;
}

/* SECTION */

section{
    padding:80px 7%;
}

.section-title{
    text-align:center;
    margin-bottom:50px;
}

.section-title h2{
    font-size:38px;
    color:#075b83;
}

.section-title p{
    margin-top:10px;
    color:#666;
}

/* CARDS */

.cards{
    display:grid;
    grid-template-columns:
    repeat(auto-fit,minmax(220px,1fr));
    gap:25px;
}

.card{
    background:white;
    padding:30px;
    border-radius:18px;
    box-shadow:0 5px 20px rgba(0,0,0,.08);
    transition:.3s;
}

.card:hover{
    transform:translateY(-8px);
    box-shadow:0 12px 30px rgba(0,0,0,.15);
}

.card .icon{
    font-size:45px;
    margin-bottom:15px;
}

.card h3{
    color:#075b83;
    margin-bottom:12px;
}

.card p{
    color:#666;
    line-height:1.6;
}

/* WHY US */

.why{
    background:#eaf8f8;
}

.why-box{
    display:grid;
    grid-template-columns:
    repeat(auto-fit,minmax(250px,1fr));
    gap:25px;
}

.why-item{
    background:white;
    padding:25px;
    border-radius:15px;
}

.why-item h3{
    color:#087f8c;
    margin-bottom:10px;
}

/* BRANCHES */

.branches{
    background:#063f59;
    color:white;
}

.branches .section-title h2{
    color:white;
}

.branch-card{
    background:white;
    color:#123;
    padding:28px;
    border-radius:18px;
    transition:.3s;
}

.branch-card:hover{
    transform:scale(1.03);
}

.branch-card h3{
    color:#075b83;
    font-size:24px;
    margin-bottom:10px;
}

.branch-card p{
    color:#555;
    line-height:1.6;
}

.branch-btn{
    display:inline-block;
    margin-top:15px;
    background:#087f8c;
    color:white;
    padding:10px 18px;
    border-radius:20px;
    text-decoration:none;
}

/* DOCTORS */

.doctor{
    text-align:center;
}

.doctor-img{
    width:110px;
    height:110px;
    border-radius:50%;
    background:#d9f3f5;
    display:flex;
    justify-content:center;
    align-items:center;
    font-size:45px;
    margin:auto auto 15px;
}

/* TESTIMONIAL */

.testimonials{
    background:#f0f9ff;
}

.quote{
    font-size:18px;
    line-height:1.7;
    color:#555;
}

/* APPOINTMENT */

.appointment{
    background:linear-gradient(
        120deg,#075b83,#078f91);
    color:white;
}

.form{
    max-width:750px;
    margin:auto;
    background:white;
    padding:35px;
    border-radius:20px;
}

.form input,
.form select,
.form textarea{
    width:100%;
    padding:15px;
    margin-bottom:15px;
    border:1px solid #ddd;
    border-radius:8px;
}

.form button{
    width:100%;
    padding:15px;
    border:none;
    border-radius:25px;
    background:#087f8c;
    color:white;
    font-size:17px;
    font-weight:bold;
    cursor:pointer;
}

/* FOOTER */

footer{
    background:#062d40;
    color:white;
    padding:50px 7%;
}

.footer-grid{
    display:grid;
    grid-template-columns:
    repeat(auto-fit,minmax(220px,1fr));
    gap:30px;
}

footer h3{
    margin-bottom:15px;
    color:#8ff3df;
}

footer p{
    color:#c9dce3;
    line-height:1.7;
}

.copyright{
    text-align:center;
    margin-top:35px;
    padding-top:20px;
    border-top:1px solid #31566a;
}

/* MOBILE */

@media(max-width:768px){

    nav{
        display:none;
    }

    .hero{
        min-height:600px;
        padding:60px 6%;
    }

    .hero h1{
        font-size:40px;
    }

    .hero p{
        font-size:17px;
    }

    .stats{
        flex-wrap:wrap;
        gap:25px;
    }

    section{
        padding:60px 6%;
    }

    .section-title h2{
        font-size:30px;
    }
}

</style>
</head>

