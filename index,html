<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>ICC Cricket World Cup 2027</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    color: white;
    background: #020b08;
    overflow-x: hidden;
}

/* =========================
   HERO BACKGROUND
========================= */

.hero {
    min-height: 100vh;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;

    background:
        linear-gradient(
            rgba(0, 20, 15, 0.45),
            rgba(0, 5, 3, 0.92)
        ),
        url("https://images.unsplash.com/photo-1531415074968-036ba1b575da?auto=format&fit=crop&w=2200&q=90");

    background-size: cover;
    background-position: center;
}

/* Dark African atmosphere */

.hero::before {
    content: "";
    position: absolute;
    inset: 0;

    background:
        radial-gradient(
            circle at 50% 35%,
            rgba(255, 180, 40, 0.20),
            transparent 30%
        ),
        linear-gradient(
            90deg,
            rgba(0, 0, 0, 0.65),
            transparent,
            rgba(0, 0, 0, 0.65)
        );
}

/* =========================
   NAVBAR
========================= */

nav {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    padding: 25px 7%;

    display: flex;
    justify-content: space-between;
    align-items: center;

    z-index: 10;

    background: rgba(0, 0, 0, 0.18);
    backdrop-filter: blur(8px);
}

.logo {
    font-size: 24px;
    font-weight: 900;
    letter-spacing: 2px;
}

.logo span {
    color: #f6c343;
}

nav ul {
    list-style: none;
    display: flex;
    gap: 35px;
}

nav a {
    color: white;
    text-decoration: none;
    font-size: 15px;
    font-weight: bold;
    transition: 0.3s;
}

nav a:hover {
    color: #f6c343;
}

/* =========================
   HERO CONTENT
========================= */

.hero-content {
    position: relative;
    z-index: 2;
    max-width: 1000px;
    padding: 120px 20px 60px;
}

.small-title {
    font-size: 18px;
    letter-spacing: 6px;
    color: #f6c343;
    font-weight: bold;
    margin-bottom: 20px;
}

h1 {
    font-size: clamp(55px, 9vw, 125px);
    line-height: 0.88;
    font-weight: 900;

    text-transform: uppercase;

    text-shadow:
        0 5px 20px rgba(0,0,0,0.7);
}

h1 span {
    color: #f6c343;
}

.subtitle {
    margin-top: 28px;
    font-size: 21px;
    color: #e5e5e5;
}

.hosts {
    margin-top: 12px;
    font-size: 17px;
    color: #cfcfcf;
}

/* =========================
   BUTTONS
========================= */

.buttons {
    margin-top: 40px;

    display: flex;
    justify-content: center;
    gap: 18px;
    flex-wrap: wrap;
}

.btn {
    padding: 15px 30px;
    border-radius: 50px;

    text-decoration: none;
    font-weight: bold;

    transition: 0.3s;
}

.btn-primary {
    background: #f6c343;
    color: #07120d;
}

.btn-primary:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 30px rgba(246,195,67,0.35);
}

.btn-outline {
    border: 1px solid rgba(255,255,255,0.6);
    color: white;
    background: rgba(255,255,255,0.08);
    backdrop-filter: blur(10px);
}

.btn-outline:hover {
    background: white;
    color: #07120d;
}

/* =========================
   FLOATING CRICKET BALL
========================= */

.ball {
    position: absolute;

    width: 75px;
    height: 75px;

    border-radius: 50%;

    right: 9%;
    top: 30%;

    background:
        radial-gradient(
            circle at 30% 30%,
            #ff4d4d,
            #a60000 65%,
            #500000
        );

    box-shadow:
        0 0 35px rgba(255,50,50,0.4);

    animation: floatBall 4s ease-in-out infinite;
}

.ball::after {
    content: "";

    position: absolute;

    width: 5px;
    height: 90px;

    background: white;

    left: 35px;
    top: -7px;

    transform: rotate(35deg);

    opacity: 0.8;
}

@keyframes floatBall {

    0%,100% {
        transform: translateY(0) rotate(0);
    }

    50% {
        transform: translateY(-30px) rotate(180deg);
    }
}

/* =========================
   INFO SECTION
========================= */

.info {
    padding: 90px 7%;

    background:
        linear-gradient(
            180deg,
            #020b08,
            #061a12
        );

    text-align: center;
}

.section-title {
    font-size: 42px;
    margin-bottom: 15px;
}

.section-title span {
    color: #f6c343;
}

.section-text {
    max-width: 700px;
    margin: auto;
    color: #aaa;
    line-height: 1.7;
}

/* =========================
   CARDS
========================= */

.cards {
    margin-top: 50px;

    display: grid;
    grid-template-columns:
        repeat(4, 1fr);

    gap: 20px;
}

.card {
    padding: 35px 20px;

    border-radius: 20px;

    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,0.10),
            rgba(255,255,255,0.03)
        );

    border: 1px solid rgba(255,255,255,0.1);

    backdrop-filter: blur(12px);

    transition: 0.3s;
}

.card:hover {
    transform: translateY(-10px);

    border-color: #f6c343;

    box-shadow:
        0 20px 50px rgba(0,0,0,0.3);
}

.card-icon {
    font-size: 38px;
    margin-bottom: 15px;
}

.card h3 {
    font-size: 27px;
    color: #f6c343;
}

.card p {
    margin-top: 8px;
    color: #aaa;
}

/* =========================
   HOST COUNTRIES
========================= */

.host-section {
    padding: 90px 7%;

    background: #020806;
    text-align: center;
}

.country-container {
    margin-top: 45px;

    display: grid;
    grid-template-columns:
        repeat(3, 1fr);

    gap: 25px;
}

.country {
    min-height: 240px;

    border-radius: 25px;

    display: flex;
    flex-direction: column;

    justify-content: center;
    align-items: center;

    background:
        linear-gradient(
            rgba(0,0,0,0.35),
            rgba(0,0,0,0.75)
        ),
        url("https://images.unsplash.com/photo-1531415074968-036ba1b575da?auto=format&fit=crop&w=1000&q=80");

    background-size: cover;
    background-position: center;

    border: 1px solid rgba(255,255,255,0.15);

    transition: 0.3s;
}

.country:hover {
    transform: scale(1.03);
}

.flag {
    font-size: 55px;
}

.country h3 {
    font-size: 30px;
    margin-top: 12px;
}

.country p {
    color: #ccc;
    margin-top: 5px;
}

/* =========================
   COUNTDOWN
========================= */

.countdown {
    padding: 90px 20px;

    text-align: center;

    background:
        linear-gradient(
            135deg,
            #062017,
            #020807
        );
}

.countdown h2 {
    font-size: 45px;
}

.countdown h2 span {
    color: #f6c343;
}

.timer {
    margin-top: 40px;

    display: flex;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
}

.time-box {
    width: 130px;

    padding: 25px 10px;

    border-radius: 18px;

    background: rgba(255,255,255,0.06);

    border: 1px solid rgba(255,255,255,0.1);
}

.time-box strong {
    display: block;

    font-size: 40px;

    color: #f6c343;
}

.time-box small {
    color: #aaa;
}

/* =========================
   FOOTER
========================= */

footer {
    padding: 30px;

    text-align: center;

    background: #010403;

    color: #777;
}

footer strong {
    color: #f6c343;
}

/* =========================
   MOBILE
========================= */

@media (max-width: 900px) {

    nav ul {
        display: none;
    }

    .cards {
        grid-template-columns:
            repeat(2, 1fr);
    }

    .country-container {
        grid-template-columns:
            1fr;
    }

    .ball {
        display: none;
    }
}

@media (max-width: 600px) {

    .cards {
        grid-template-columns: 1fr;
    }

    h1 {
        font-size: 55px;
    }

    .subtitle {
        font-size: 17px;
    }

    .section-title {
        font-size: 32px;
    }

    .countdown h2 {
        font-size: 32px;
    }
}
</style>
</head>

<body>

<!-- =========================
     NAVIGATION
========================= -->

<nav>

    <div class="logo">
        CWC <span>2027</span>
    </div>

    <ul>
        <li><a href="#home">Home</a></li>
        <li><a href="#about">Tournament</a></li>
        <li><a href="#hosts">Hosts</a></li>
        <li><a href="#countdown">Countdown</a></li>
    </ul>

</nav>


<!-- =========================
     HERO
========================= -->

<section class="hero" id="home">

    <div class="ball"></div>

    <div class="hero-content">

        <div class="small-title">
            ICC MEN'S CRICKET
        </div>

        <h1>
            WORLD CUP<br>
            <span>2027</span>
        </h1>

        <p class="subtitle">
            The world comes together in Africa
        </p>

        <p class="hosts">
            🇿🇦 South Africa &nbsp; • &nbsp;
            🇿🇼 Zimbabwe &nbsp; • &nbsp;
            🇳🇦 Namibia
        </p>

        <div class="buttons">

            <a href="#about" class="btn btn-primary">
                Explore Tournament
            </a>

            <a href="#countdown" class="btn btn-outline">
                Countdown
            </a>

        </div>

    </div>

</section>


<!-- =========================
     TOURNAMENT INFO
========================= -->

<section class="info" id="about">

    <h2 class="section-title">
        THE <span>BIGGEST</span> STAGE
    </h2>

    <p class="section-text">
        The ICC Men's Cricket World Cup 2027 will bring
        the world's best cricket teams together across
        Africa for one of the biggest sporting events
        on the planet.
    </p>


    <div class="cards">

        <div class="card">

            <div class="card-icon">🏆</div>

            <h3>2027</h3>

            <p>World Cup Year</p>

        </div>


        <div class="card">

            <div class="card-icon">🏏</div>

            <h3>14</h3>

            <p>Teams</p>

        </div>


        <div class="card">

            <div class="card-icon">🎯</div>

            <h3>57</h3>

            <p>Matches</p>

        </div>


        <div class="card">

            <div class="card-icon">🏟️</div>

            <h3>12</h3>

            <p>Venues</p>

        </div>

    </div>

</section>


<!-- =========================
     HOST COUNTRIES
========================= -->

<section class="host-section" id="hosts">

    <h2 class="section-title">
        HOST <span>NATIONS</span>
    </h2>

    <p class="section-text">
        Three African nations will host the 2027
        Cricket World Cup.
    </p>


    <div class="country-container">

        <div class="country">

            <div class="flag">🇿🇦</div>

            <h3>South Africa</h3>

            <p>Main Host</p>

        </div>


        <div class="country">

            <div class="flag">🇿🇼</div>

            <h3>Zimbabwe</h3>

            <p>Co-host</p>

        </div>


        <div class="country">

            <div class="flag">🇳🇦</div>

            <h3>Namibia</h3>

            <p>Co-host</p>

        </div>

    </div>

</section>


<!-- =========================
     COUNTDOWN
========================= -->

<section class="countdown" id="countdown">

    <h2>
        COUNTDOWN TO <span>2027</span>
    </h2>

    <div class="timer">

        <div class="time-box">
            <strong id="days">00</strong>
            <small>DAYS</small>
        </div>

        <div class="time-box">
            <strong id="hours">00</strong>
            <small>HOURS</small>
        </div>

        <div class="time-box">
            <strong id="minutes">00</strong>
            <small>MINUTES</small>
        </div>

        <div class="time-box">
            <strong id="seconds">00</strong>
            <small>SECONDS</small>
        </div>

    </div>

</section>


<!-- =========================
     FOOTER
========================= -->

<footer>

    <p>
        Designed for <strong>ICC Cricket World Cup 2027</strong>
    </p>

    <p style="margin-top:8px;">
        South Africa • Zimbabwe • Namibia
    </p>

</footer>


<!-- =========================
     JAVASCRIPT
========================= -->

<script>

const targetDate =
    new Date("2027-10-01T00:00:00").getTime();

function updateCountdown() {

    const now = new Date().getTime();

    const difference = targetDate - now;

    if (difference <= 0) {

        document.getElementById("days").innerText = "00";
        document.getElementById("hours").innerText = "00";
        document.getElementById("minutes").innerText = "00";
        document.getElementById("seconds").innerText = "00";

        return;
    }

    const days =
        Math.floor(
            difference /
            (1000 * 60 * 60 * 24)
        );

    const hours =
        Math.floor(
            (difference /
            (1000 * 60 * 60)) % 24
        );

    const minutes =
        Math.floor(
            (difference /
            (1000 * 60)) % 60
        );

    const seconds =
        Math.floor(
            (difference / 1000) % 60
        );

    document.getElementById("days")
        .innerText = days;

    document.getElementById("hours")
        .innerText =
        String(hours).padStart(2, "0");

    document.getElementById("minutes")
        .innerText =
        String(minutes).padStart(2, "0");

    document.getElementById("seconds")
        .innerText =
        String(seconds).padStart(2, "0");
}

updateCountdown();

setInterval(updateCountdown, 1000);

</script>

</body>
</html>
